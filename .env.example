# ── Database (Neon / Supabase / any Postgres) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/auditexpert

# ── Razorpay (server-side only — never expose) ────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Public key for Checkout initialization (safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Payments fallback mode ────────────────────────────────────────────
# "razorpay" requires real credentials. "mock" enables safe demo mode.
PAYMENT_PROVIDER=mock

# ── Email (Resend / SendGrid etc.) ────────────────────────────────────
EMAIL_PROVIDER_API_KEY=your_email_api_key
ADMIN_NOTIFICATION_EMAIL=audits@auditexpert.in

# ── Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://auditexpert.in
